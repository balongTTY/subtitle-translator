/* Win11 深色主题 */

QWidget {
    color: #FFFFFF;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QDialog, QGroupBox {
    background: #1F1F1F;
}

/* 菜单 */
QMenuBar { background: #2D2D2D; border-bottom: 1px solid #3D3D3D; padding: 2px; }
QMenuBar::item { padding: 4px 12px; border-radius: 4px; }
QMenuBar::item:selected { background: #1E3A5F; color: #60CDFF; }
QMenu { background: #2D2D2D; border: 1px solid #3D3D3D; border-radius: 8px; padding: 4px; }
QMenu::item { padding: 6px 24px; border-radius: 4px; }
QMenu::item:selected { background: #1E3A5F; color: #60CDFF; }

/* 按钮 */
QPushButton {
    background: transparent;
    color: #CCCCCC;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 5px 14px;
    min-height: 28px;
}
QPushButton:hover { background: #3A3A3A; border-color: #777777; }
QPushButton:pressed { background: #4A4A4A; }
QPushButton:disabled { background: transparent; color: #555555; border-color: #3A3A3A; }

QPushButton#primaryBtn {
    background: #0078D4;
    color: #FFFFFF;
    border: none;
    font-weight: bold;
    padding: 8px 20px;
    min-height: 24px;
}
QPushButton#primaryBtn:hover { background: #1A88E0; }
QPushButton#primaryBtn:pressed { background: #005A9E; }
QPushButton#primaryBtn:disabled { background: #3D3D3D; color: #666666; }

/* 工具栏分组分隔线 */
QWidget#toolbarSep {
    background: #3F3F46;
    border: none;
}

QPushButton#dangerBtn {
    background: transparent;
    color: #FF99A4;
    border: 1px solid #FF99A4;
}
QPushButton#dangerBtn:hover { background: #FF99A4; color: #1A1A1A; }

QPushButton#smallBtn {
    padding: 2px 8px;
    min-height: 20px;
    font-size: 8pt;
}

/* 输入框 */
QLineEdit, QTextEdit, QPlainTextEdit {
    background: #2D2D2D;
    border: 1px solid #3D3D3D;
    border-radius: 4px;
    padding: 6px 8px;
    selection-background-color: #60CDFF;
    selection-color: #1A1A1A;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: #60CDFF; }

/* 下拉框 */
QComboBox {
    background: #2D2D2D;
    border: 1px solid #3D3D3D;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
}
QComboBox:hover { border-color: #60CDFF; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: #2D2D2D;
    border: 1px solid #3D3D3D;
    border-radius: 4px;
    selection-background-color: #1E3A5F;
    selection-color: #FFFFFF;
}

/* 数值输入框 */
QSpinBox, QDoubleSpinBox {
    background: #2D2D2D;
    border: 1px solid #3D3D3D;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #60CDFF; }

/* 标签页 */
QTabWidget::pane { background: #2D2D2D; border: 1px solid #3D3D3D; border-radius: 8px; }
QTabBar::tab { background: transparent; border: none; padding: 8px 16px; margin-right: 2px; }
QTabBar::tab:selected { color: #60CDFF; border-bottom: 2px solid #60CDFF; }
QTabBar::tab:hover:!selected { border-bottom: 2px solid #555555; }

/* 分组框 */
QGroupBox {
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    margin-top: 8px;
    padding: 16px 8px 8px 8px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* 表格和树 */
QTableWidget, QTreeWidget {
    background: #2D2D2D;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    gridline-color: #383838;
    alternate-background-color: #2A2A2A;
    selection-background-color: #1E3A5F;
    selection-color: #FFFFFF;
}
QTableWidget::item, QTreeWidget::item { padding: 4px 6px; }
QHeaderView::section {
    background: #2E2E2E;
    border: none;
    border-bottom: 1px solid #3D3D3D;
    padding: 6px 8px;
    font-weight: bold;
}

/* 进度条 */
QProgressBar {
    background: #3D3D3D;
    border: none;
    border-radius: 4px;
    text-align: center;
    min-height: 18px;
}
QProgressBar::chunk { background: #0078D4; border-radius: 4px; }

/* 滚动条 */
QScrollBar:vertical { background: transparent; width: 6px; }
QScrollBar::handle:vertical { background: #555555; min-height: 30px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: #777777; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 6px; }
QScrollBar::handle:horizontal { background: #555555; min-width: 30px; border-radius: 3px; }
QScrollBar::handle:horizontal:hover { background: #777777; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* 分割器 */
QSplitter::handle { background: #3D3D3D; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }

QStatusBar { background: #2D2D2D; border-top: 1px solid #3D3D3D; padding: 2px 8px; color: #AAAAAA; }
QToolTip { background: #FFFFFF; color: #1A1A1A; border: none; border-radius: 4px; padding: 4px 8px; }
QLabel#warningLabel { color: #FCE100; font-weight: bold; }
